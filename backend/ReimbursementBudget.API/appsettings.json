{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=ReimbursementBudgetDb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "REPLACE_WITH_STRONG_SECRET_FROM_ENVIRONMENT",
    "Issuer": "ReimbursementBudget.API",
    "Audience": "ReimbursementBudget.Client"
  },
  "PaymentSandbox": {
    "FailThreshold": 9000000,
    "TimeoutThreshold": 9500000,
    "Comment": "Payments >= FailThreshold will fail; >= TimeoutThreshold will timeout. These are sandbox simulation settings only."
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
